<%- include('partials/header', { pageTitle: "Reports" }) %>

<div class="container py-4">
  <h1 class="mb-2">Reports</h1>
  <p class="text-muted mb-4">
    Running totals by status (families / control numbers).
    <% if (generatedAt) { %>
      As of <%= generatedAt.toLocaleString() %>.
    <% } %>
    Refresh this page for a live count.
  </p>

  <% if (error) { %>
    <div class="alert alert-danger"><%= error %></div>
  <% } %>

  <div class="row g-3 mb-4">
    <div class="col-md-3 col-sm-6">
      <div class="card border-primary h-100">
        <div class="card-body">
          <h6 class="text-primary text-uppercase mb-1">Approved</h6>
          <div class="display-5 fw-semibold"><%= counts.approved %></div>
          <small class="text-muted">Waiting to shop</small>
        </div>
      </div>
    </div>
    <div class="col-md-3 col-sm-6">
      <div class="card border-warning h-100">
        <div class="card-body">
          <h6 class="text-warning text-uppercase mb-1">Being shopped</h6>
          <div class="display-5 fw-semibold"><%= counts.being_shopped %></div>
          <small class="text-muted">On the floor</small>
        </div>
      </div>
    </div>
    <div class="col-md-3 col-sm-6">
      <div class="card border-info h-100">
        <div class="card-body">
          <h6 class="text-info text-uppercase mb-1">Ready for pickup</h6>
          <div class="display-5 fw-semibold"><%= counts.ready_for_pickup %></div>
          <small class="text-muted">Bagged and binned</small>
        </div>
      </div>
    </div>
    <div class="col-md-3 col-sm-6">
      <div class="card border-success h-100">
        <div class="card-body">
          <h6 class="text-success text-uppercase mb-1">Complete</h6>
          <div class="display-5 fw-semibold"><%= counts.complete %></div>
          <small class="text-muted">Picked up</small>
        </div>
      </div>
    </div>
  </div>

  <div class="card mb-4">
    <div class="card-body d-flex justify-content-between align-items-center">
      <div>
        <h5 class="mb-0">Total families</h5>
        <small class="text-muted">Sum of the four statuses<% if (counts.other) { %> plus unexpected status values<% } %></small>
      </div>
      <div class="display-6 fw-semibold"><%= total %></div>
    </div>
  </div>

  <h2 class="h4 mb-3">Items recorded</h2>
  <p class="text-muted">
    Running totals from bags entered at Ready for Pickup (and kept after Complete).
    Approved and Being Shopped are usually zero until a family is bagged.
  </p>
  <div class="row g-3 mb-4">
    <div class="col-md-4">
      <div class="card h-100">
        <div class="card-body">
          <h6 class="text-uppercase mb-1">Toys</h6>
          <div class="display-5 fw-semibold"><%= items.toys %></div>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card h-100">
        <div class="card-body">
          <h6 class="text-uppercase mb-1">Books</h6>
          <div class="display-5 fw-semibold"><%= items.books %></div>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card h-100">
        <div class="card-body">
          <h6 class="text-uppercase mb-1">Stocking stuffers</h6>
          <div class="display-5 fw-semibold"><%= items.stuffers %></div>
        </div>
      </div>
    </div>
  </div>

  <% if (counts.other) { %>
    <div class="alert alert-warning mt-3">
      <%= counts.other %> row(s) have a status that is not one of the four expected values.
      That should not happen in season — check the database before loading more data.
    </div>
  <% } %>

  <h2 class="h4 mb-3 mt-4">Shopped on a date</h2>
  <p class="text-muted">
    Control numbers whose bags were saved that day (being shopped → ready for pickup).
    Date is the Melbourne calendar day stored in shopped_date.
  </p>
  <form method="get" action="/reports" class="row g-2 align-items-end mb-3">
    <div class="col-auto">
      <label for="shopped" class="form-label mb-1">Date</label>
      <input
        id="shopped"
        name="shopped"
        type="date"
        class="form-control"
        value="<%= shoppedDate || '' %>"
        required
      />
    </div>
    <div class="col-auto">
      <button type="submit" class="btn btn-primary">Show shopped</button>
    </div>
    <% if (pickupDate) { %>
      <input type="hidden" name="pickup" value="<%= pickupDate %>" />
    <% } %>
  </form>

  <% if (shoppedError) { %>
    <div class="alert alert-warning"><%= shoppedError %></div>
  <% } else if (shoppedDate) { %>
    <div class="card mb-4">
      <div class="card-body">
        <h5 class="mb-3"><%= shopped.length %> shopped on <%= shoppedDate %></h5>
        <% if (!shopped.length) { %>
          <p class="text-muted mb-0">No control numbers have that shopped date.</p>
        <% } else { %>
          <label for="shoppedList" class="form-label">Control numbers</label>
          <select id="shoppedList" class="form-select" size="1">
            <% shopped.forEach(function (row) { %>
              <option>
                <%= row.control_number %> — <%= row.status %><% if (row.bin) { %>, bin <%= row.bin %><% } %><% if (row.bags) { %>, <%= row.bags %> bag<% if (Number(row.bags) !== 1) { %>s<% } %><% } %>
              </option>
            <% }) %>
          </select>
        <% } %>
      </div>
    </div>
  <% } %>

  <h2 class="h4 mb-3 mt-4">Picked up on a date</h2>
  <p class="text-muted">
    Control numbers marked complete that day. Date is the value stored in pickup_date.
  </p>
  <form method="get" action="/reports" class="row g-2 align-items-end mb-3">
    <div class="col-auto">
      <label for="pickup" class="form-label mb-1">Date</label>
      <input
        id="pickup"
        name="pickup"
        type="date"
        class="form-control"
        value="<%= pickupDate || '' %>"
        required
      />
    </div>
    <div class="col-auto">
      <button type="submit" class="btn btn-primary">Show picked up</button>
    </div>
    <% if (shoppedDate) { %>
      <input type="hidden" name="shopped" value="<%= shoppedDate %>" />
    <% } %>
  </form>

  <% if (pickupError) { %>
    <div class="alert alert-warning"><%= pickupError %></div>
  <% } else if (pickupDate) { %>
    <div class="card mb-4">
      <div class="card-body">
        <h5 class="mb-3"><%= pickedUp.length %> picked up on <%= pickupDate %></h5>
        <% if (!pickedUp.length) { %>
          <p class="text-muted mb-0">No control numbers have that pickup date.</p>
        <% } else { %>
          <label for="pickupList" class="form-label">Control numbers</label>
          <select id="pickupList" class="form-select" size="1">
            <% pickedUp.forEach(function (row) { %>
              <option>
                <%= row.control_number %> — <%= row.status %><% if (row.bin) { %>, bin <%= row.bin %><% } %><% if (row.bags) { %>, <%= row.bags %> bag<% if (Number(row.bags) !== 1) { %>s<% } %><% } %>
              </option>
            <% }) %>
          </select>
        <% } %>
      </div>
    </div>
  <% } %>

  <h2 class="h4 mb-3 mt-4">CSV dump</h2>
  <p class="text-muted">
    Look-only copy of workflow families. One row per control number, children listed on that row.
    Not a loader file, and not a database restore.
  </p>
  <a class="btn btn-outline-secondary" href="/reports/csv">Create CSV dump</a>
</div>
